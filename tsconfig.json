{
  "compilerOptions": {
    "rootDir": "./src/scripts",
    "outDir": "./dist/scripts",
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "lib": ["DOM", "ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["src/scripts/**/*", "src/types/**/*"]
}
