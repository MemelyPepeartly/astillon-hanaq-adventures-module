{
  "name": "astillon-hanaq-adventures-module",
  "version": "0.10.8",
  "description": "A collection of FoundryVTT Pathfinder 2e Content for Astillon and Hanaq",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ./build/build.mjs",
    "clean": "node ./build/build.mjs --clean",
    "test": "npm run build && node --test",
    "typecheck": "tsc --noEmit",
    "test:local": "node ./build/build.mjs && xcopy /s /e /y /i dist \"%LOCALAPPDATA%\\FoundryVTT\\Data\\modules\\astillon-hanaq-adventures-module\\\""
  },
  "author": "Memely",
  "license": "MIT",
  "engines": {
    "node": ">=20.15.0"
  },
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "13.345.1",
    "@types/node": "^24.7.1",
    "gifuct-js": "^2.1.2",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
